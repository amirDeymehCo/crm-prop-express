# ───────── یکپارچه‌سازی با پنل PHP (بازیابی حساب) ─────────
# کلیدی که برنامه‌نویس PHP در هدر X-API-Key می‌فرستد.
# با این دستور یکی بساز:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PARTNER_API_KEY=
PARTNER_RATE_LIMIT=600

# آدرس پایه‌ی همین سرویس، برای ساخت callback درگاه پرداخت بازیابی
CRM_API_BASE_URL=https://api-crm.myprop.trade/api/v1

# API ای که PHP باید بدهد؛ بعد از پرداخت موفق بازیابی صدا زده می‌شود.
# تا وقتی خالی باشد، اطلاع‌رسانی در صف می‌ماند و با
# POST /api/v1/partner/recovery/callbacks/retry ارسال می‌شود.
PHP_RECOVERY_CALLBACK_URL=https://propmanager.myprop.trade/api/recovery/paid

# خالی بگذار: کلید ارسالی به PHP همان PARTNER_API_KEY می‌شود.
# فقط اگر خواستی کلید رفت‌و‌برگشت جدا باشد این را پر کن.
